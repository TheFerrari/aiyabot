# Token for your discord app. You can get it from https://discordapp.com/developers/applications/me
TOKEN=
# Allows you to set a custom URL, including port. The default is "http://127.0.0.1:7860".
URL=http://127.0.0.1:7860
# Your timezone in the format of "America/New_York". The default is "America/New_York".
TZ=America/New_York
# Your username if you are using --api-auth
APIUSER=
# Your password if you are using --api-auth
APIPASS=
# Allows you to set a custom folder to save images. The default is "/app/outputs".
DIR=/app/outputs
# Your username if you are using --share and --gradio-auth.
USER=
# Your password if you are using --share and --gradio-auth.
PASS=

# -------------------- Stable Diffusion process control (optional) --------------------
# These variables enable /sdcontrol to start/stop/restart your local WebUI process.
#
# Recommended method (full command + working directory):
# Example (Windows): SD_START_COMMAND=webui-user.bat --api
SD_START_COMMAND=
# Example (Windows): SD_START_WORKDIR=E:\AI\stable-diffusion-webui-forge-on-amd
SD_START_WORKDIR=
#
# Alternative method (full path to startup script/bat):
# Example (Windows): SD_START_BAT_PATH=E:\AI\stable-diffusion-webui-forge-on-amd\webui-user.bat
SD_START_BAT_PATH=
#
# Optional timeout in seconds while waiting for /sdapi after start/restart.
SD_START_TIMEOUT_S=120
# Optional extra users allowed to use /sdcontrol (comma, semicolon, or space-separated Discord IDs).
# Example: SD_CONTROL_ALLOWED_USER_IDS=123456789012345678,987654321098765432
SD_CONTROL_ALLOWED_USER_IDS=

# Optional: folder where your Stable Diffusion WebUI lives (for auto-restart).
# Example (Windows): SD_FOLDER_PATH=E:\AI\stable-diffusion-webui-forge-on-amd
SD_FOLDER_PATH=
# Optional: .bat file name that starts the WebUI inside SD_FOLDER_PATH.
# Example: SD_START_BAT_FILE_NAME=webui-user.bat
SD_START_BAT_FILE_NAME=

#Allows you to enable or disable the slash generate command 
USE_GENERATE=False

# -------------------- Power monitor (optional) --------------------
# Enable Discord /power command and background sampling.
ENABLE_POWER_MONITOR=False
# Sampling interval in seconds.
POWER_SAMPLE_INTERVAL_S=5
# Max in-memory samples for /power summary/graph history.
POWER_HISTORY_MAX_SAMPLES=30000

# Reader mode: hwinfo_csv | mock | windows_battery
POWER_READER=hwinfo_csv

# Mock reader (for testing)
MOCK_POWER_WATTS=120

# Windows battery reader (mainly laptops)
BATTERY_CAPACITY_WH=50
BATTERY_MIN_INTERVAL_S=20

# HWiNFO CSV reader (recommended on Windows desktop/mini PC)
HWINFO_CSV_PATH=
# Generic power/temperature fallback matching
HWINFO_POWER_COLUMN_KEYWORDS=Total System Power [W],Core+SoC+SR Power (SVI3 TFN) [W],APU STAPM [W],CPU Package Power [W],GPU ASIC Power [W]
HWINFO_TEMP_COLUMN_KEYWORDS=CPU (Tctl/Tdie) [°C],CPU Core [°C],Core Temperatures (avg) [°C],GPU Temperature [°C],APU GFX [°C],CPU SOC [°C]

# Detailed snapshot matching used by /power output
HWINFO_TOTAL_POWER_KEYWORDS=Total System Power [W],Core+SoC+SR Power (SVI3 TFN) [W],APU STAPM [W],CPU Package Power [W]
HWINFO_CPU_POWER_KEYWORDS=CPU Package Power [W],CPU Core Power (SVI3 TFN) [W],Core+SoC+SR Power (SVI3 TFN) [W]
HWINFO_GPU_POWER_KEYWORDS=GPU ASIC Power [W]
HWINFO_STAPM_POWER_KEYWORDS=APU STAPM [W]
HWINFO_CPU_TEMP_KEYWORDS=CPU (Tctl/Tdie) [°C],CPU Core [°C],Core Temperatures (avg) [°C]
HWINFO_GPU_TEMP_KEYWORDS=GPU Temperature [°C],APU GFX [°C]
HWINFO_SOC_TEMP_KEYWORDS=CPU SOC [°C]
